{
   "GET /api/articles": {
      "content-type": "api::article.article",
      "roles": {
         "authenticated": {
            "populate": {
               "author": {
                  "fields": [
                     "name",
                     "email",
                     "createdAt",
                     "updatedAt",
                     "id"
                  ],
                  "populate": {
                     "articles": {
                        "populate": {
                           "category": {}
                        }
                     }
                  }
               }
            },
            "fields": [
               "title",
               "description",
               "slug",
               "documentId",
               "publishedAt",
               "id",
               "updatedAt",
               "createdAt"
            ]
         },
         "public": {
            "populate": {},
            "fields": [
               "title"
            ]
         }
      }
   },
   "DELETE /api/about": {
      "content-type": "api::temp.temp",
      "fields": [
         "color"
      ]
   }
}